# ── Copy to `.env` and fill in the blanks ───────────────────────────────

# ── LLM ── choose ONE provider: gemini | openai | anthropic
LLM_PROVIDER=gemini

# Gemini (has a free tier). Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key
# Model names change often — pick a current one from AI Studio's model list.
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (paid). Only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (paid). Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── PostgreSQL ── defaults match docker-compose.yml
POSTGRES_USER=archive_user
POSTGRES_PASSWORD=archive_pass
POSTGRES_DB=archive_db
DATABASE_URL=db_url

# ── Qdrant (vector DB) ── default matches docker-compose.yml
# Local/Docker Qdrant: http://qdrant:6333 (leave QDRANT_API_KEY blank)
# Qdrant Cloud (no-Docker setup): https://YOUR-CLUSTER.qdrant.io  + your API key
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=document_chunks

# ── Embeddings / chunking ──
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VECTOR_DIMENSION=384
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
# Chunks scoring below this cosine similarity are dropped before the LLM sees them
MIN_RELEVANCE=0.30

# ── Auth ──
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Sign-In: the *Web* OAuth client ID (see AUTH_SETUP.md)
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Facebook Login (see AUTH_SETUP.md)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Phone + OTP sign-in — path to the service-account JSON from
# Firebase Console > Project Settings > Service accounts > Generate new private key
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# ── Storage / CORS ──
UPLOAD_DIR=/app/storage/uploads
CORS_ORIGINS=*
